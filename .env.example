## ============================================================
## RetailOps Next '26 Platform Showcase — Environment Variables
## ============================================================
## Copy this file to .env and fill in your values.
## All sections except "Core GCP" are optional for local development.

## ---- Core GCP (required for cloud deployment) ---------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
STAGING_BUCKET=gs://your-staging-bucket
BQ_DATASET=retailops_demo
BQ_PRODUCTS_TABLE=products
BQ_SALES_TABLE=sales

## ---- Cloud Run Tool API ------------------------------------
CLOUDRUN_TOOL_API_BASE_URL=https://your-tool-api-url
# Set to true only for local debugging against http:// URLs without ID tokens.
CLOUDRUN_TOOL_API_SKIP_ID_TOKEN=false

## ---- Agent Runtime -----------------------------------------
MEMORY_BANK_ENABLED=true
# Set true only in non-prod or where compliance approves logging prompts/responses.
CAPTURE_GENAI_MESSAGE_CONTENT=false
RUNTIME_SERVICE_ACCOUNT=
DEPLOYED_AGENT_NAME=retailops-copilot

## ---- Workstream A: Durable Workflows -----------------------
# local (default) — file-backed JSON in WORKFLOW_STATE_DIR
# firestore       — Firestore (optional-integration; requires GCP project + Firestore)
WORKFLOW_STATE_BACKEND=local
WORKFLOW_STATE_DIR=.local/state

## ---- Workstream B: A2A Federation (preview-scaffold) -------
# WARNING: Gemini Enterprise A2A registration is a preview feature.
# Set true only if you have preview program access.
ENABLE_A2A_EXPERIMENTAL=false
# true = use local mock agents (runnable-now, no external deps)
# false = use registered Gemini Enterprise agents (requires ENABLE_A2A_EXPERIMENTAL=true)
A2A_USE_MOCKS=true
A2A_PROVIDER_ID=retailops-demo-org
# Required only for real A2A registration (preview):
# A2A_REGISTRY_URL=https://...

## ---- Workstream C: Remote MCP Server -----------------------
# Set true for local development (skips Cloud Run IAM auth check).
REMOTE_MCP_SKIP_AUTH=false

## ---- Workstream E: Workspace Connectors (optional-integration) ---
# WARNING: Requires Google Workspace API credentials and service account.
# Set true only after completing setup in docs/workspace-connectors.md.
ENABLE_WORKSPACE_CONNECTORS=false
